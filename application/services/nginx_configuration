server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mastercontroller.home localhost;

    ssl_certificate /etc/ssl/zyrax/zyrax.crt;
    ssl_certificate_key /etc/ssl/zyrax/zyrax.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 50M;

    location = /favicon.ico {
        alias /etc/ZyraX_Home/application/static/images/favicon.ico;
        types { image/x-icon ico; }
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name mastercontroller.home localhost;
    return 308 https://mastercontroller.home$request_uri;
}
